auto-install-peers=true
# medusa-plugin-razorpay-v2 hard-pins its Medusa peers to 2.12.3 while this repo
# runs 2.19.0. The provider code itself targets the current interface — it reads
# input.context.idempotency_key and { amount, currency_code }, which is what
# 2.19 passes — so the pin is over-strict rather than a real incompatibility.
# Set here rather than passed ad hoc so `npm ci` in the Dockerfile resolves the
# tree the same way a local install does.
legacy-peer-deps=true
